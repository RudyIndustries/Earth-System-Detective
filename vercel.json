{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "nextjs"
    },
    "backend": {
      "root": "backend",
      "framework": "nestjs",
      "functions": {
        "src/main.ts": {
          "includeFiles": "../{config/settings.json,data/national/{results,agua_artificial}.json,data/real/{*.json,context/*,img/*.png},data/{real,sample}/{results.json,suspects.csv,uma.db,validation/{results.json,uma.db}}}"
        }
      }
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "backend" } },
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ]
}
